{
  "name": "telegram-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply telegram-planner-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply telegram-planner-db --remote",
    "typecheck": "tsc --noEmit",
    "webhook:set": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "wrangler": "^3.90.0",
    "@cloudflare/workers-types": "^4.20250101.0"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  }
}
